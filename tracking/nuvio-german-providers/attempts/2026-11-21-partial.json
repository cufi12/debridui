  "pagesWorkflow": {
    "blobSha1": "426b364a943d6e43ec5686a1243d0a8693785508",
    "content": "name: Deploy to GitHub Pages\n\non:\n  push:\n    branches: [main]\n  workflow_dispatch:\n\npermissions:\n  contents: read\n  pages: write\n  id-token: write\n\nconcurrency:\n  group: pages\n  cancel-in-progress: true\n\njobs:\n  deploy:\n    runs-on: ubuntu-latest\n    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}manifest.json\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm\n      - run: npm ci\n      # rebuild from src/ so Pages never serves stale bundles; also validates manifest.json\n      - run: node build.js\n      - run: node check.js\n      - name: Collect site\n        run: |\n          mkdir _site\n          cp -r manifest.json providers _site/\n      - uses: actions/upload-pages-artifact@v3\n      - id: deployment\n        uses: actions/deploy-pages@v4\n"
  },
